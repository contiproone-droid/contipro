# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo ".env" de verdade no repositório.

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-forte-e-unica

# True em desenvolvimento, False em produção.
DEBUG=True

# Hosts permitidos, separados por vírgula. Em produção inclua o domínio do Render.
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Origens confiáveis para CSRF (precisa do esquema https://), separadas por vírgula.
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# String de conexão do banco PostgreSQL (Neon). Deixe em branco para usar SQLite local.
# Exemplo (Neon já inclui sslmode=require na connection string):
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/nomedobanco?sslmode=require
DATABASE_URL=

# Chave de criptografia dos campos sensíveis (senha, dados 2FA/backup).
# Gere uma nova com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ou:
#   python manage.py generate_encryption_key
# Guarde essa chave em local seguro: se ela for perdida ou trocada, os dados
# já criptografados no banco NÃO poderão mais ser lidos.
FIELD_ENCRYPTION_KEY=troque-por-uma-chave-fernet-gerada
